{
  "name": "@starlink/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-agent-yaml.mjs",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "lint": "tsc --noEmit",
    "db:migrate": "pnpm run build && node --env-file=.env dist/infrastructure/db/migrate.js",
    "memory:reap": "pnpm run build && node --env-file=.env dist/scripts/memory-reap.js",
    "db:use:local": "cp .env.pg-local .env && echo 'Switched to local Postgres profile'",
    "db:use:supabase": "cp .env.supabase .env && echo 'Switched to Supabase profile (remember to bypass proxy + run db:migrate first time)'",
    "db:show": "head -1 .env && grep -E '^DATABASE_URL=|^LANGGRAPH_MODEL=' .env",
    "test": "pnpm --filter @starlink/shared build && pnpm run clean && pnpm run build && find dist -name '*.test.js' -print | xargs node --env-file=.env --test",
    "smoke:access-subscriptions": "pnpm run build && node dist/scripts/smoke-access-subscriptions.js",
    "smoke:task-events": "pnpm run build && node dist/scripts/smoke-task-event-store.js",
    "smoke:conversation-runtime": "pnpm run build && node dist/scripts/smoke-conversation-runtime-store.js",
    "smoke:citation-pipeline": "pnpm run build && node dist/scripts/smoke-citation-pipeline.js",
    "smoke:langsmith": "pnpm run build && node --env-file=.env dist/scripts/smoke-langsmith-config.js",
    "smoke:hitl-cross-instance": "pnpm run build && node --env-file=.env dist/scripts/smoke-hitl-cross-instance.js",
    "smoke:hitl-langgraph": "pnpm run build && node dist/scripts/smoke-hitl-langgraph.js",
    "smoke:report-stream": "pnpm run build && node --env-file=.env dist/scripts/smoke-report-writer-stream.js",
    "smoke:canvas-mutations": "pnpm run build && node --env-file=.env dist/scripts/smoke-canvas-mutations.js",
    "smoke:hitl-pg-cross-instance": "pnpm run build && node --env-file=.env dist/scripts/smoke-hitl-pg-cross-instance.js",
    "smoke:hitl-restart-concurrent": "pnpm run build && node --env-file=.env dist/scripts/smoke-hitl-restart-concurrent.js",
    "validate:agents": "pnpm run build && node --env-file=.env dist/scripts/validate-agents.js",
    "kb:reembed": "pnpm run build && node --env-file=.env dist/scripts/reembed-kb-chunks.js",
    "kb:seed-bench": "pnpm run build && node --env-file=.env dist/scripts/seed-rag-benchmark-kbs.js",
    "reap-sessions": "pnpm run build && node --env-file=.env dist/scripts/session-reaper.js",
    "reap-sessions:watch": "pnpm run build && node --env-file=.env dist/scripts/session-reaper.js --watch",
    "benchmark:run": "pnpm run build && node --env-file=.env dist/benchmark/cli.js",
    "eval:yc": "pnpm run build && node --env-file=.env dist/benchmark/eval/yc-vs-runners.js",
    "eval:yc-kb": "pnpm run build && node --env-file=.env dist/benchmark/eval/yc-vs-runners.js --with-kb-only",
    "eval:judge-smoke": "pnpm run build && node --env-file=.env dist/benchmark/eval/yc-judge-smoke.js",
    "eval:coaching": "pnpm run build && node --env-file=.env dist/benchmark/coaching/run-coach-eval.js",
    "eval:rag": "pnpm run build && node --env-file=.env dist/benchmark/eval/rag-quality.js",
    "smoke:all": "pnpm run build && node dist/scripts/smoke-task-event-store.js && node dist/scripts/smoke-conversation-runtime-store.js && node dist/scripts/smoke-access-subscriptions.js && node dist/scripts/smoke-citation-pipeline.js",
    "ci": "pnpm run lint && pnpm run validate:agents && pnpm run test && pnpm run smoke:all",
    "eval:all": "pnpm run eval:judge-smoke && pnpm run eval:yc && pnpm run eval:coaching"
  },
  "dependencies": {
    "@apollo/server": "^4.11.2",
    "@graphql-tools/schema": "^10.0.13",
    "@langchain/core": "^1.1.12",
    "@langchain/langgraph": "^1.0.13",
    "@langchain/langgraph-checkpoint-postgres": "^0.1.0",
    "@langchain/openai": "^1.2.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.51.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.55.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.55.0",
    "@opentelemetry/resources": "^1.28.0",
    "@opentelemetry/sdk-metrics": "^1.30.1",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@starlink/shared": "workspace:*",
    "@supabase/supabase-js": "^2.78.0",
    "@types/multer": "^2.1.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "graphql": "^16.11.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-tag": "^2.12.6",
    "graphql-type-json": "^0.3.2",
    "graphql-ws": "^6.0.6",
    "helmet": "^7.0.0",
    "ioredis": "^5.10.0",
    "langsmith": "^0.5.19",
    "mammoth": "^1.12.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "nanoid": "^5.0.7",
    "pdf-parse": "^2.4.5",
    "pg": "^8.14.0",
    "ws": "^8.18.3",
    "xlsx": "^0.18.5",
    "yaml": "^2.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.7",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.10",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
