# GraphQL
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4001/graphql
BACKEND_API_BASE_URL=http://localhost:4000

# Dify API
DIFY_API_BASE_URL=https://api.dify.ai/v1
DIFY_FILE_TRANSLATION_APP_ID=your_workflow_id_here
DIFY_FILE_TRANSLATION_API_KEY=your_dify_api_key_here
DIFY_DEEP_RESEARCH_APP_ID=your_deep_research_workflow_id_here
DIFY_DEEP_RESEARCH_API_KEY=your_deep_research_dify_api_key_here

# LLM API (用于 AI 任务拆分)
# 支持 providers: openai, anthropic, deepseek, custom
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini